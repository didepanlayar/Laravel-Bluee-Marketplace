### Install Laravel and Dependencies

# Laravel 12
- composer create-project "laravel/laravel:^12.0" Bluee

# Configure /etc/hosts for localhost

# Create database
- CREATE DATABASE database_name;
- GRANT ALL PRIVILEGES ON database_name.* TO 'database_user'@'%';
- FLUSH PRIVILEGES;

# Configure .env with Docker-Server

DB_CONNECTION=mysql
DB_HOST=mysql (Docker Service)
DB_PORT=3306
DB_DATABASE=database_name
DB_USERNAME=database_user
DB_PASSWORD=database_secret

SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_HOST=redis (Docker Service)
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379

# Check database connection
- php artisan db:monitor

# Check redis connection
- php artisan tinker
> Cache::put('test', 'redis-works', 10);
> Cache::get('test');
Output: "redis-works"

# Modify .gitignore and README.md

# Create app/Helpers/ResponseHelper.php

# Create app/Traits/UUID.php

# Modify User Models

# Modify create_users_table.php migrations

# Database migrate
- php artisan migrate

# Models and Migration: Store
- php artisan make:model Store -m

# Models and Migration: StoreBalance
- php artisan make:model StoreBalance -m

# Models and Migration: StoreBalanceHistory
- php artisan make:model StoreBalanceHistory -m

# Models and Migration: Withdrawal
- php artisan make:model Withdrawal -m

# Models and Migration: Buyer
- php artisan make:model Buyer -m

# Models and Migration: ProductCategory
- php artisan make:model ProductCategory -m

# Models and Migration: Product
- php artisan make:model Product -m

# Models and Migration: ProductImage
- php artisan make:model ProductImage -m

# Models and Migration: Transaction
- php artisan make:model Transaction -m

# Models and Migration: TransactionDetail
- php artisan make:model TransactionDetail -m

# Models and Migration: ProductReview
- php artisan make:model ProductReview -m

# Fix Models and Migration typo then fresh migrate
- php artisan migrate:fresh

### API User

# Create app/Interfaces/UserRepositoryInterface.php
# Create app/Repositories/UserRepository.php
# Add ScopeSearch function to User Models
# Register to Provider
- php artisan make:provider RepositoryServiceProvider
# Modify RepositoryServiceProvider.php
# Create PaginateResource
- php artisan make:resource PaginateResource
# Create UserResource
- php artisan make:resource UserResource
# Create UserController
- php artisan make:controller UserController --api
# Install API Route
- php artisan install:api

### CRUD User

# Fix app/Helpers/ResponseHelper.php and app/Repositories/UserRepository.php

# Create dummy User data
- php artisan make:seeder UserSeeder
# Modify UserSeeder then seed
- php artisan db:seed --class=UserSeeder

